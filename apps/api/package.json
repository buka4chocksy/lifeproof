{
  "name": "@lifeproof/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @lifeproof/contracts build && nest start --watch",
    "build": "pnpm --filter @lifeproof/contracts build && nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "pnpm --filter @lifeproof/contracts build && tsc --noEmit",
    "test": "pnpm --filter @lifeproof/contracts build && vitest run",
    "test:watch": "pnpm --filter @lifeproof/contracts build && vitest"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@lifeproof/contracts": "workspace:*",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.22",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
